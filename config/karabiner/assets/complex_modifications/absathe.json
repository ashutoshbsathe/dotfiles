{
  "title": "absathe@ Workflow",
  "rules": [
    {
      "description": "Win + R -> Spotlight (Cmd + Space)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "r",
            "modifiers": { "mandatory": ["left_control"] }
          },
          "to": [
            { "key_code": "spacebar", "modifiers": ["left_command"] }
          ]
        }
      ]
    },
    {
      "description": "Win + Shift + C -> Close Window (Cmd + W)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": { "mandatory": ["left_control", "left_shift"] }
          },
          "to": [
            { "key_code": "w", "modifiers": ["left_command"] }
          ]
        }
      ]
    },
    {
      "description": "Win + Shift + T -> Launch iTerm2",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": { "mandatory": ["left_control", "left_shift"] }
          },
          "to": [
            { "shell_command": "open -a iTerm" }
          ]
        }
      ]
    },
    {
      "description": "Win + Esc -> Lock Screen (Ctrl + Cmd + Q)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "escape",
            "modifiers": { "mandatory": ["left_control"] }
          },
          "to": [
            { "key_code": "q", "modifiers": ["left_control", "left_command"] }
          ]
        }
      ]
    },
    {
      "description": "Alt + Tab -> App Switcher (Cmd + Tab)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": [
            { "key_code": "tab", "modifiers": ["left_command"] }
          ]
        }
      ]
    },
    {
      "description": "Universal Word Nav (Ctrl/Cmd + Arrow -> Option + Arrow)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": { "mandatory": ["left_command"] }
          },
          "to": [{ "key_code": "left_arrow", "modifiers": ["left_option"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": { "mandatory": ["left_control"] }
          },
          "to": [{ "key_code": "left_arrow", "modifiers": ["left_option"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_arrow",
            "modifiers": { "mandatory": ["left_command"] }
          },
          "to": [{ "key_code": "right_arrow", "modifiers": ["left_option"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_arrow",
            "modifiers": { "mandatory": ["left_control"] }
          },
          "to": [{ "key_code": "right_arrow", "modifiers": ["left_option"] }]
        }
      ]
    },
    {
      "description": "Global Swap: Physical Ctrl -> Logical Cmd",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_command" }]
        }
      ]
    },
    {
      "description": "Global Swap: Physical Cmd -> Logical Ctrl",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }]
        }
      ]
    }
  ]
}
